PORT=5000

# MongoDB. Local:   mongodb://127.0.0.1:27017/nexus_db
#          Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus_db
MONGO_URI=mongodb://127.0.0.1:27017/nexus_db

# How the city's traffic starts (the BACKEND generates it, the frontend never does):
#   saved   (default) reuse the traffic saved in MongoDB; generate random traffic the first time
#   random  generate new random traffic on every start
#   none    start with no traffic at all
TRAFFIC_ON_START=saved

# ---- Sign in (phone number + OTP, JWT) ----
# Required in production: a random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# country code added to numbers typed without one (91 = India)
DEFAULT_COUNTRY_CODE=91

# how the OTP text is sent: console (prints it in the server log, development only) or twilio
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...            (or TWILIO_MESSAGING_SERVICE_SID=)

# every /api route (except /api/auth) needs a signed-in user. Set false to turn that off for
# curl / scripts/demo.mjs
# AUTH_REQUIRED=true

# development only: also return the code in the request-otp answer (ignored when NODE_ENV=production)
DEV_RETURN_OTP=false

# limits (defaults shown)
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=30
# OTP_MAX_PER_HOUR=5
# OTP_MAX_ATTEMPTS=5
