PORT=5000

# MongoDB. Local:   mongodb://127.0.0.1:27017/nexus_db
#          Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus_db
MONGO_URI=your_mongodb_connection_string_here

# How the city's traffic starts (the BACKEND generates it, the frontend never does):
#   saved   (default) reuse the traffic saved in MongoDB; generate random traffic the first time
#   random  generate new random traffic on every start
#   none    start with no traffic at all
TRAFFIC_ON_START=saved
